<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="../Styles/ProfilePanelUI.uss" />
    <!-- Profile Panel Container -->
    <ui:VisualElement class="panel-content">
        <ui:Label text="Profile" class="panel-title" />
        
        <!-- Status and Loading -->
        <ui:Label name="profile-status" class="status-label" />
        <ui:VisualElement name="profile-loading" class="loading-indicator">
            <ui:Label text="Processing..." class="loading-text" />
        </ui:VisualElement>
        
        <!-- Profile Information Section -->
        <ui:VisualElement name="profile-info-section" class="profile-section">
            <ui:Label text="User Information" class="section-title" />
            <ui:VisualElement class="profile-info-grid">
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="User ID:" class="profile-label" />
                    <ui:Label name="user-id" text="Loading..." class="profile-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Username:" class="profile-label" />
                    <ui:Label name="username" text="Loading..." class="profile-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Email:" class="profile-label" />
                    <ui:Label name="email" text="Loading..." class="profile-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Score:" class="profile-label" />
                    <ui:Label name="score" text="0" class="profile-value score-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Credits:" class="profile-label" />
                    <ui:Label name="credits" text="0" class="profile-value credits-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Last Login:" class="profile-label" />
                    <ui:Label name="last-login" text="N/A" class="profile-value" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Login Count:" class="profile-label" />
                    <ui:Label name="login-count" text="0" class="profile-value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Score Management Section -->
        <ui:VisualElement name="score-management-section" class="profile-section">
            <ui:Label text="Score Management" class="section-title" />
            <ui:VisualElement class="management-controls">
                <ui:TextField name="score-input" placeholder-text="Enter score amount" class="management-input" />
                <ui:VisualElement name="score-buttons" class="management-buttons">
                    <ui:Button name="set-score-button" text="Set Score" class="management-button primary" />
                    <ui:Button name="add-score-button" text="Add Score" class="management-button secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Set an absolute score value or add to the current score" class="help-text" />
        </ui:VisualElement>

        <!-- Credits Management Section -->
        <ui:VisualElement name="credits-management-section" class="profile-section">
            <ui:Label text="Credits Management" class="section-title" />
            <ui:VisualElement class="management-controls">
                <ui:TextField name="credits-input" placeholder-text="Enter credits amount" class="management-input" />
                <ui:VisualElement name="credits-buttons" class="management-buttons">
                    <ui:Button name="set-credits-button" text="Set Credits" class="management-button primary" />
                    <ui:Button name="add-credits-button" text="Add Credits" class="management-button secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="Set absolute credits value or add to the current balance" class="help-text" />
        </ui:VisualElement>

        <!-- User Attributes Section -->
        <ui:VisualElement name="attributes-section" class="profile-section">
            <ui:VisualElement class="section-header">
                <ui:Label text="User Attributes" class="section-title" />
                <ui:Button name="refresh-attributes-button" text="Refresh" class="refresh-button" />
            </ui:VisualElement>
            
            <!-- Add New Attribute -->
            <ui:VisualElement class="add-attribute-controls">
                <ui:TextField name="new-attribute-key" placeholder-text="Attribute Key" class="attribute-input" />
                <ui:TextField name="new-attribute-value" placeholder-text="Attribute Value" class="attribute-input" />
                <ui:Button name="add-attribute-button" text="Add Attribute" class="management-button primary" />
            </ui:VisualElement>
            
            <!-- Attributes List -->
            <ui:ScrollView class="attributes-scroll">
                <ui:VisualElement name="attributes-list" class="attributes-list">
                    <!-- Attributes will be populated dynamically -->
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Batch Attributes Section -->
        <ui:VisualElement name="batch-attributes-section" class="profile-section">
            <ui:Label text="Batch Attribute Operations" class="section-title" />
            <ui:Label text="Add multiple attributes at once for efficient bulk operations" class="help-text" />
            
            <ui:VisualElement class="batch-controls">
                <ui:Button name="add-batch-row-button" text="+ Add Row" class="management-button secondary" />
                <ui:Button name="save-batch-attributes-button" text="Save All" class="management-button primary" />
                <ui:Button name="clear-batch-button" text="Clear All" class="management-button danger" />
            </ui:VisualElement>
            
            <!-- Batch Attributes List -->
            <ui:ScrollView class="batch-attributes-scroll">
                <ui:VisualElement name="batch-attributes-list" class="batch-attributes-list">
                    <!-- Batch rows will be populated dynamically -->
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>