/* === ENHANCED PROFILE PANEL STYLES - FIXED LAYOUT === */

/* Global profile section structure */
.profile-section {
    display: flex;
    flex-direction: column;
    overflow: visible;
}

/* Ensure proper section title inheritance */
.profile-section .section-title {
    margin-bottom: 15px;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

/* Management Sections - New Structure */
#score-management-section,
#credits-management-section {
    display: flex;
    flex-direction: column;
}

/* Content wrapper for better control */
.section-content-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    overflow: visible;
}

/* Ensure all children in wrapper maintain their size */
.section-content-wrapper > * {
    flex-shrink: 0;
    position: relative;
}

/* Section spacer - guaranteed height */
.section-spacer {
    height: 25px;
    min-height: 25px;
    max-height: 25px;
    flex-shrink: 0;
    flex-grow: 0;
    width: 100%;
    background-color: transparent;
    /* Debug: uncomment to see spacer */
    /* background-color: rgba(255, 0, 0, 0.1); */
}

/* Management section titles */
#score-management-section .section-title,
#credits-management-section .section-title {
    margin-bottom: 0;
    margin-top: 0;
    padding: 0;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    flex-shrink: 0;
}

/* Ensure management controls have no top margin */
#score-management-section .management-controls,
#credits-management-section .management-controls {
    margin-top: 0;
    margin-bottom: 10px;
    position: relative;
}

/* Profile Information Grid */
.profile-info-grid {
    flex-direction: column;
}

.profile-info-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.profile-label {
    width: 120px;
    color: rgb(200, 200, 200);
    font-size: 14px;
    margin-right: 15px;
    flex-shrink: 0;
}

.profile-value {
    color: rgb(255, 255, 255);
    font-size: 14px;
    flex: 1;
}

.score-value {
    color: rgb(100, 180, 255);
    font-weight: bold;
}

.credits-value {
    color: rgb(255, 200, 100);
    font-weight: bold;
}

/* Management Controls - FIXED */
.management-controls {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 10px;
    margin-top: 0;
    width: 100%;
    position: relative;
    flex-shrink: 0;
}

.management-input {
    flex: 1;
    margin-right: 15px;
    margin-top: 0;
    height: 35px;
    min-width: 200px;
    max-width: 300px;
}

.management-input .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 8px;
    height: 35px;
}

.management-input .unity-text-field__input:focus {
    border-color: rgb(100, 180, 255);
}

.management-buttons {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
}

.management-button {
    height: 35px;
    margin-left: 8px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 4px;
    border-width: 0;
    padding: 8px 15px;
    font-size: 14px;
    min-width: 80px;
    flex-shrink: 0;
}

.management-button.primary {
    background-color: rgb(100, 180, 255);
    color: rgb(255, 255, 255);
}

.management-button.primary:hover {
    background-color: rgb(120, 190, 255);
}

.management-button.secondary {
    background-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
}

.management-button.secondary:hover {
    background-color: rgb(100, 100, 100);
}

.management-button.danger {
    background-color: rgb(180, 60, 60);
    color: rgb(255, 255, 255);
}

.management-button.danger:hover {
    background-color: rgb(200, 70, 70);
}

.management-button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
}

.help-text {
    color: rgb(160, 160, 160);
    font-size: 12px;
    font-style: italic;
    margin-top: 0;
    margin-bottom: 0;
    line-height: 1.4;
    flex-shrink: 0;
}

/* Section Header - FIXED */
.section-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    width: 100%;
    min-height: 30px;
}

/* Special handling for section header title */
.section-header .section-title {
    margin-bottom: 0;
    margin-right: 10px;
    line-height: 30px;
    align-self: center;
}

.refresh-button {
    background-color: rgb(70, 70, 70);
    color: rgb(200, 200, 200);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    height: 30px;
    padding: 6px 12px;
    font-size: 12px;
    flex-shrink: 0;
    margin-left: 10px;
}

.refresh-button:hover {
    background-color: rgb(90, 90, 90);
    color: rgb(255, 255, 255);
}

/* Attributes - FIXED WITH PROPER SPACING */
#attributes-section {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
}

#attributes-section > * {
    position: relative;
    flex-shrink: 0;
    flex-grow: 0;
}

#attributes-section .section-header {
    margin-bottom: 30px !important;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    order: 1;
}

.add-attribute-controls {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 20px;
    margin-top: 0;
    padding-top: 0;
    width: 100%;
    gap: 10px;
    overflow: visible;
    position: relative;
    order: 2;
}

.attributes-scroll {
    order: 3;
    flex: 1 1 0;
    min-height: 150px;
    max-height: 250px;
    margin-bottom: 15px;
    margin-top: 0;
    background-color: rgb(40, 40, 40);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    overflow: hidden;
}

.attribute-input {
    flex: 1;
    margin-right: 0;
    height: 35px;
    min-width: 150px;
}

.attribute-input .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 8px;
    height: 35px;
}

.attribute-input .unity-text-field__input:focus {
    border-color: rgb(100, 180, 255);
}

/* Fix for Add Attribute button alignment */
.add-attribute-controls .management-button {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    min-width: 120px;
}

/* Merged with earlier definition - removed duplicate */

.attributes-list {
    padding: 10px;
}

.attribute-row {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 5px;
    background-color: rgb(50, 50, 50);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.attribute-key {
    width: 150px;
    color: rgb(100, 180, 255);
    font-size: 14px;
    font-weight: bold;
    margin-right: 15px;
    flex-shrink: 0;
}

.attribute-value {
    flex: 1;
    color: rgb(255, 255, 255);
    font-size: 14px;
    margin-right: 15px;
    word-wrap: break-word;
}

.delete-attribute-button {
    background-color: rgb(180, 60, 60);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 3px;
    height: 25px;
    padding: 4px 8px;
    font-size: 12px;
    flex-shrink: 0;
}

.delete-attribute-button:hover {
    background-color: rgb(200, 70, 70);
}

.no-data-label {
    color: rgb(150, 150, 150);
    font-style: italic;
    text-align: center;
    padding: 20px;
}


/* Status Container - Fixed Height */
.status-container {
    height: 60px;
    min-height: 60px;
    max-height: 60px;
    margin-bottom: 10px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
}

/* Loading and Status Enhancements - Fixed Layout */
#profile-status {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex !important;
    visibility: hidden;
    padding: 10px;
    border-radius: 4px;
    text-align: center;
    font-size: 14px;
    height: 40px;
    align-items: center;
    justify-content: center;
}

#profile-loading {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex !important;
    visibility: hidden;
    align-items: center;
    justify-content: center;
    height: 40px;
}

.loading-text {
    color: rgb(100, 180, 255);
    font-size: 14px;
    font-style: italic;
}

/* Show status and loading when active */
#profile-status.show,
#profile-loading.show {
    visibility: visible;
}

/* When status has success or error class, make it visible */
#profile-status.status-success,
#profile-status.status-error {
    visibility: visible;
}

/* Merged with earlier definition - removed duplicate */

#profile-status.status-success {
    background-color: rgba(60, 180, 60, 0.2);
    border-width: 1px;
    border-color: rgb(60, 180, 60);
    color: rgb(120, 255, 120);
}

#profile-status.status-error {
    background-color: rgba(180, 60, 60, 0.2);
    border-width: 1px;
    border-color: rgb(180, 60, 60);
    color: rgb(255, 120, 120);
}

/* Responsive Adjustments for Profile Panel - IMPROVED */
@media (max-width: 1024px) {
    .management-controls {
        flex-direction: column;
        align-items: stretch;
    }
    
    .management-input {
        margin-right: 0;
        margin-bottom: 10px;
        max-width: none;
    }
    
    .management-buttons {
        justify-content: flex-start;
        flex-wrap: wrap;
    }
    
    .management-button {
        margin-left: 0;
        margin-right: 8px;
        margin-bottom: 5px;
    }
    
    .add-attribute-controls {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }
    
    .attribute-input {
        margin-right: 0;
        margin-bottom: 0;
    }
    
    .add-attribute-controls .management-button {
        margin-left: 0;
        margin-top: 0;
        align-self: flex-start;
        width: 100%;
    }
}

@media (max-width: 768px) {
    .profile-info-row {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .profile-label {
        width: auto;
        margin-bottom: 4px;
        margin-right: 0;
    }
    
    .attribute-row {
        flex-direction: column;
        align-items: stretch;
        padding: 10px;
    }
    
    .attribute-key,
    .attribute-value {
        width: auto;
        margin-right: 0;
        margin-bottom: 5px;
    }
    
    .delete-attribute-button {
        align-self: flex-end;
    }
    
}