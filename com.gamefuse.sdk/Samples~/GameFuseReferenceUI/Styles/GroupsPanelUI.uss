/* Groups Panel Specific Styles */

.groups-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

/* Tab Navigation */
.tabs-container {
    flex-direction: row;
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.1);
    padding-bottom: 5px;
}

.tab-button {
    margin: 0 5px;
    padding: 8px 15px;
    background-color: transparent;
    border-width: 0;
    border-radius: 5px;
    color: #666;
    font-size: 14px;
    -unity-font-style: normal;
    transition-property: background-color, color;
    transition-duration: 0.2s;
}

.tab-button:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

.active-tab {
    background-color: rgba(0, 0, 0, 0.1);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.tab-panel {
    padding: 10px;
}

/* Groups Controls */
.groups-controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

/* Groups List */
.groups-list {
    background-color: rgb(40, 40, 40);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    padding: 10px;
    height: 400px;
    min-height: 300px;
}

.group-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    margin: 5px 0;
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    transition-property: background-color;
    transition-duration: 0.2s;
}

.group-item:hover {
    background-color: rgb(60, 60, 60);
}

.group-info {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.group-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background-color: rgb(80, 80, 80);
    margin-right: 12px;
    flex-shrink: 0;
}

.group-details {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.group-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 3px;
}

.group-description {
    font-size: 13px;
    color: rgb(180, 180, 180);
    margin-bottom: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.group-privacy {
    font-size: 12px;
    color: rgb(150, 150, 150);
    padding: 2px 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
}

.group-created {
    font-size: 12px;
    color: rgb(150, 150, 150);
}

.group-actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: 10px;
}

.group-action-button {
    margin-left: 5px;
    padding: 6px 12px;
    font-size: 13px;
    border-radius: 4px;
    border-width: 0;
    height: 32px;
}

/* Search Controls */
.search-controls {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 15px;
}

.search-input {
    flex-grow: 1;
    margin-right: 10px;
    height: 35px;
}

.search-input .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 8px;
    height: 35px;
    font-size: 14px;
}

.search-input .unity-text-field__input:focus {
    border-color: rgb(100, 180, 255);
}

.search-button {
    height: 35px;
    padding: 8px 15px;
    font-size: 14px;
}

/* Group Creation Form */
.group-form {
    background-color: rgb(45, 45, 45);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    padding: 20px;
}

.form-field {
    margin-bottom: 15px;
}

.form-field .unity-text-field__label {
    color: rgb(200, 200, 200);
    font-size: 14px;
    margin-bottom: 5px;
    min-width: 0;
}

.form-field .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 8px;
    font-size: 14px;
}

.form-field.multiline .unity-text-field__input {
    white-space: normal;
    -unity-text-align: upper-left;
}

.form-label {
    color: rgb(200, 200, 200);
    font-size: 14px;
    margin-bottom: 8px;
    margin-top: 10px;
}

.form-toggle {
    margin-bottom: 5px;
}

.form-toggle .unity-toggle__label {
    color: rgb(200, 200, 200);
    font-size: 14px;
}

.attributes-container {
    background-color: rgb(50, 50, 50);
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 15px;
}

.attribute-row {
    flex-direction: row;
    margin-bottom: 5px;
}

.attribute-key-field,
.attribute-value-field {
    flex-grow: 1;
    margin-right: 5px;
    height: 30px;
}

.attribute-key-field .unity-text-field__input,
.attribute-value-field .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    padding: 5px;
    height: 30px;
    font-size: 13px;
}

.add-attribute-button {
    margin-top: 5px;
    padding: 5px 10px;
    font-size: 13px;
}

.remove-attribute-button {
    padding: 5px 10px;
    font-size: 12px;
    height: 30px;
}

.form-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
}

.form-button {
    padding: 8px 20px;
    font-size: 14px;
    height: 35px;
    border-radius: 4px;
    border-width: 0;
}

/* Group Details Popup */
.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    display: none;
}

.popup-container {
    width: 600px;
    max-width: 90%;
    max-height: 80%;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(70, 70, 70);
}

.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
    padding: 15px 20px;
}

.popup-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.popup-close {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: rgb(180, 60, 60);
    color: white;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    -unity-font-style: bold;
}

.popup-close:hover {
    background-color: rgb(200, 70, 70);
}

.popup-content-scroll {
    max-height: 600px;
}

.popup-content {
    padding: 20px;
}

.group-info-section {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
}

.group-info-section .group-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.group-info-section .group-description {
    font-size: 14px;
    color: rgb(200, 200, 200);
    white-space: normal;
    margin-bottom: 15px;
}

.group-stats {
    flex-direction: row;
}

.stat-item {
    flex-direction: row;
    align-items: center;
}

.stat-label {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-right: 5px;
}

.stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* Admin Controls Section */
.admin-controls-section {
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    padding: 15px;
    margin-bottom: 20px;
}

.admin-button {
    padding: 6px 15px;
    font-size: 13px;
    height: 32px;
}

/* Group Attributes Section */
.group-attributes-section {
    margin-bottom: 20px;
}

.section-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.attributes-list {
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    padding: 10px;
    max-height: 150px;
}

.attribute-item {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
    margin: 3px 0;
    background-color: rgb(60, 60, 60);
    border-radius: 3px;
}

.attribute-key {
    font-size: 14px;
    color: rgb(200, 200, 200);
}

.attribute-value {
    font-size: 14px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.empty-attributes {
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    padding: 15px;
}

/* Group Members Section */
.group-members-section {
    margin-bottom: 20px;
}

.members-list {
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    padding: 10px;
    max-height: 200px;
}

.member-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px;
    margin: 3px 0;
    background-color: rgb(60, 60, 60);
    border-radius: 3px;
}

.member-info {
    flex-direction: row;
    align-items: center;
}

.member-avatar {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(80, 80, 80);
    margin-right: 10px;
}

.member-name {
    font-size: 14px;
    color: rgb(255, 255, 255);
}

.member-actions {
    flex-direction: row;
}

.remove-member-button {
    padding: 4px 10px;
    font-size: 12px;
    height: 28px;
}

.empty-members {
    color: rgb(150, 150, 150);
    -unity-text-align: middle-center;
    padding: 15px;
}

/* Empty States */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-icon {
    width: 80px;
    height: 80px;
    background-color: rgb(70, 70, 70);
    border-radius: 40px;
    margin-bottom: 15px;
}

.empty-text {
    color: rgb(180, 180, 180);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
    font-size: 14px;
}

/* Counters */
.count-label {
    font-size: 14px;
    color: rgb(200, 200, 200);
}

.count-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* Pagination Controls */
.pagination-controls {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 10px;
    padding: 10px;
}

.pagination-button {
    margin: 0 5px;
    padding: 8px 15px;
    font-size: 14px;
    height: 35px;
}

.pagination-button:disabled {
    opacity: 0.5;
    cursor: default;
}

.page-info {
    font-size: 14px;
    color: rgb(200, 200, 200);
    margin: 0 15px;
}

/* Button Variants */
.primary {
    background-color: rgb(100, 180, 255);
    color: rgb(255, 255, 255);
}

.primary:hover {
    background-color: rgb(120, 190, 255);
}

.secondary {
    background-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
}

.secondary:hover {
    background-color: rgb(100, 100, 100);
}

.success {
    background-color: rgb(60, 180, 120);
    color: rgb(255, 255, 255);
}

.success:hover {
    background-color: rgb(70, 200, 130);
}

.danger {
    background-color: rgb(180, 60, 60);
    color: rgb(255, 255, 255);
}

.danger:hover {
    background-color: rgb(200, 70, 70);
}

.refresh-button {
    height: 35px;
    padding: 8px 15px;
    font-size: 14px;
}