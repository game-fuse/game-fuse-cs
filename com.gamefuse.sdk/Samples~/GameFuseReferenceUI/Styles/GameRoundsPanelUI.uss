.panel-container {
    flex: 1;
    padding: 20px;
}

.panel-title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    color: rgb(255, 255, 255);
}

.content-area {
    flex: 1;
}

/* Create Round Form */
.form-container {
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.form-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    color: rgb(255, 255, 255);
}

.form-field {
    margin-bottom: 15px;
}

.form-field Label {
    min-width: 150px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
}

.form-field .unity-text-field__input,
.form-field .unity-integer-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 6px;
}

.form-field .unity-text-field__input:focus,
.form-field .unity-integer-field__input:focus {
    border-color: rgb(100, 180, 255);
}

.form-field .unity-toggle__checkmark {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
}

.form-field .unity-toggle__checkmark:checked {
    background-color: rgb(33, 150, 243);
    border-color: rgb(33, 150, 243);
}

.metadata-field TextInput {
    height: 60px;
}

.button-row {
    flex-direction: row;
    margin-top: 20px;
}

.button-row Button {
    margin-right: 10px;
}

/* Rounds List */
.list-container {
    flex: 1;
}

.list-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 15px;
}

.filter-controls {
    flex-direction: row;
    margin-bottom: 15px;
    align-items: center;
}

.filter-input {
    flex: 1;
    margin-right: 10px;
}

.filter-input .unity-text-field__input {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
    border-radius: 4px;
    color: rgb(255, 255, 255);
    padding: 8px;
}

.filter-input .unity-text-field__input:focus {
    border-color: rgb(100, 180, 255);
}

.filter-button {
    padding: 5px 15px;
    margin-left: 5px;
}

.rounds-list {
    flex: 1;
    background-color: rgb(40, 40, 40);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    padding: 10px;
}

.round-item {
    background-color: rgb(50, 50, 50);
    border-radius: 5px;
    padding: 15px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.round-item:hover {
    background-color: rgb(60, 60, 60);
    border-color: rgb(80, 80, 80);
}

.round-type {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    color: rgb(255, 255, 255);
}

.round-score {
    font-size: 14px;
    margin-bottom: 5px;
    color: rgb(180, 180, 180);
}

.round-date {
    font-size: 12px;
    color: rgb(150, 150, 150);
    margin-bottom: 10px;
}

.view-button {
    background-color: rgb(76, 175, 80);
    color: white;
    padding: 5px 15px;
    border-radius: 4px;
}

.view-button:hover {
    background-color: rgb(66, 165, 70);
}

/* Pagination */
.pagination-controls {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 15px;
    padding: 10px;
}

.pagination-button {
    padding: 5px 15px;
    margin: 0 10px;
}

.page-label {
    margin: 0 15px;
    font-size: 14px;
    -unity-font-style: bold;
}

/* Details Panel */
.details-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    bottom: 20px;
    width: 400px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    padding: 20px;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.details-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    color: rgb(255, 255, 255);
}

.details-scroll {
    flex: 1;
    margin-bottom: 15px;
}

.details-content {
    white-space: normal;
    font-size: 14px;
    line-height: 20px;
    color: rgb(220, 220, 220);
}

/* Common Styles */
.primary-button {
    background-color: rgb(33, 150, 243);
    color: white;
    padding: 8px 20px;
    border-radius: 4px;
    -unity-font-style: bold;
}

.primary-button:hover {
    background-color: rgb(30, 136, 229);
}

.secondary-button {
    background-color: rgb(158, 158, 158);
    color: white;
    padding: 8px 20px;
    border-radius: 4px;
}

.secondary-button:hover {
    background-color: rgb(117, 117, 117);
}

.empty-label {
    -unity-text-align: middle-center;
    padding: 40px;
    color: rgb(150, 150, 150);
    font-size: 16px;
}