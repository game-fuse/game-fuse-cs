<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xmlns="UnityEngine.UIElements" 
      xsi:schemaLocation="UnityEngine.UIElements ../UIElementsSchema/UnityEngine.UIElements.xsd">
  <VisualElement name="data-panel" class="panel">
    <Label text="GameFuse Data" class="title" />
    
    <VisualElement name="user-info-panel" class="data-section">
      <Label text="User Information" class="subtitle" />
      <VisualElement class="info-row">
        <Label text="Username:" class="info-label" />
        <Label name="username-value" text="-" class="info-value" />
      </VisualElement>
      <VisualElement class="info-row">
        <Label text="Email:" class="info-label" />
        <Label name="email-value" text="-" class="info-value" />
      </VisualElement>
      <VisualElement class="info-row">
        <Label text="Credits:" class="info-label" />
        <Label name="credits-value" text="-" class="info-value" />
      </VisualElement>
      <VisualElement class="info-row">
        <Label text="Score:" class="info-label" />
        <Label name="score-value" text="-" class="info-value" />
      </VisualElement>
      <Button name="refresh-user-button" text="Refresh User Info" class="button secondary" />
    </VisualElement>
    
    <VisualElement name="store-panel" class="data-section">
      <Label text="Store Items" class="subtitle" />
      <VisualElement name="store-items-container" class="list-container">
        <ListView name="store-items-list" item-height="50" />
      </VisualElement>
      <Button name="refresh-store-button" text="Load Store Items" class="button secondary" />
    </VisualElement>
    
    <VisualElement name="friends-panel" class="data-section">
      <Label text="Friends" class="subtitle" />
      <VisualElement name="friends-container" class="list-container">
        <ListView name="friends-list" item-height="50" />
      </VisualElement>
      <Button name="refresh-friends-button" text="Load Friends" class="button secondary" />
    </VisualElement>
    
    <VisualElement name="leaderboard-panel" class="data-section">
      <Label text="Leaderboard" class="subtitle" />
      <VisualElement name="leaderboard-container" class="list-container">
        <ListView name="leaderboard-list" item-height="50" />
      </VisualElement>
      <Button name="refresh-leaderboard-button" text="Load Leaderboard" class="button secondary" />
    </VisualElement>
    
    <Button name="sign-out-button" text="Sign Out" class="button danger" />
  </VisualElement>
</UXML>