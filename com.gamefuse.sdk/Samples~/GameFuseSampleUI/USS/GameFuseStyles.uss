/* Base Styles */
.panel {
    padding: 16px;
    background-color: #1E1E1E;
    border-radius: 8px;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
}

.title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 16px;
    color: #E0E0E0;
}

.subtitle {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    color: #CCCCCC;
}

/* Form Styles */
.form-panel {
    margin-bottom: 16px;
    padding: 12px;
    background-color: #2A2A2A;
    border-radius: 4px;
}

.form-field {
    margin-bottom: 8px;
}

.form-field Label {
    color: #BBBBBB;
}

.form-field TextField {
    background-color: #333333;
    border-color: #444444;
    border-width: 1px;
    border-radius: 2px;
    padding: 4px;
    color: #EEEEEE;
}

.row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

/* Button Styles */
.button {
    padding: 8px 16px;
    margin: 4px;
    border-width: 0;
    border-radius: 4px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.button:hover {
    scale: 1.05;
}

.button.primary {
    background-color: #4A66A0;
    color: white;
}

.button.secondary {
    background-color: #555555;
    color: white;
}

.button.danger {
    background-color: #A04A4A;
    color: white;
    margin-top: 16px;
}

.button.text {
    background-color: transparent;
    color: #4A66A0;
    padding: 4px 8px;
    font-size: 12px;
    -unity-font-style: normal;
    margin-top: 4px;
}

/* Message Panel */
.message-panel {
    background-color: #3A3A3A;
    padding: 8px;
    border-radius: 4px;
    margin-top: 8px;
}

/* Data Section */
.data-section {
    background-color: #2A2A2A;
    padding: 12px;
    border-radius: 4px;
    margin-bottom: 16px;
}

.info-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.info-label {
    width: 120px;
    -unity-font-style: bold;
    color: #BBBBBB;
}

.info-value {
    color: #EEEEEE;
    flex-grow: 1;
}

.list-container {
    height: 150px;
    border-width: 1px;
    border-color: #444444;
    background-color: #333333;
    margin-bottom: 8px;
}

.list-item {
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #444444;
}

.list-item:hover {
    background-color: #3A3A3A;
}

.list-item-main {
    -unity-font-style: bold;
    color: #EEEEEE;
}

.list-item-secondary {
    font-size: 12px;
    color: #BBBBBB;
}